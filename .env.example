HTTP_ADDR=:8080
DATABASE_URL=postgres://soprovod:soprovod@db:5432/soprovod?sslmode=disable
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
RESUME_PATH=resume/resume.md
TEMPLATE_PATH=resume/template.md
STATIC_DIR=frontend/dist
# Source for vacancy data: "html" (scrape hh.ru vacancy page, default) or
# "api" (use the public api.hh.ru JSON API).
HH_SOURCE=html

# Used by docker-compose for the db service itself.
POSTGRES_USER=soprovod
POSTGRES_PASSWORD=soprovod
POSTGRES_DB=soprovod
